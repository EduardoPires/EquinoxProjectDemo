@{
    ViewData["Title"] = "Welcome";
}

<div>
    <img src="~/images/banner1.svg" alt="ASP.NET" class="img-responsive" />
    <p>Estudado e alterado com o Claude Code.</p>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Clientes</h5>
                    <p class="card-text">Cadastro, edição e histórico de clientes, com as regras de negócio no domínio.</p>
                    <a asp-area="" asp-controller="Customer" asp-action="Index" class="card-link">Ver a lista de clientes</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">API</h5>
                    <p class="card-text">Os mesmos casos de uso expostos por uma API protegida por autenticação.</p>
                    <a href="https://localhost:5001/swagger" target="_blank" class="card-link">Abrir a documentação da API</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Identity</h5>
                    <p class="card-text">Registro, login e as permissões de quem usa o site.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="card-link">Ir para o login</a>
                </div>
            </div>
        </div>
    </div>
    <br />
</div>

<div class="row">
    <div class="col-md-6">
        <h2>Design</h2>
        <ul>
            <li>Full architecture with responsibility separation concerns, SOLID and Clean Code</li>
            <li>DDD Concepts - Layers and Domain Model Pattern</li>
            <li>CQRS - Command Query Responsibility Segregation</li>
            <li>Event Sourcing</li>
        </ul>
    </div>
    <div class="col-md-3">
        <h2>Technologies</h2>
        <ul>
            <li>.NET 10.0</li>
            <li>ASP.NET MVC 10.0</li>
            <li>ASP.NET WebAPI 10.0</li>
            <li>ASP.NET Identity 10.0</li>
            <li>EF Core 10.0</li>
            <li>AutoMapper</li>
            <li>FluentValidator</li>
            <li>MediatR</li>
            <li>Swagger UI</li>
        </ul>
    </div>
    <div class="col-md-3">
        <h2>Run</h2>
        <ul>
            <li><a href="http://equinoxproject.azurewebsites.net" target="_blank">See Online</a></li>
            <li>Run anywhere</li>
            <li>Scale on the cloud</li>
        </ul>
    </div>
</div>
