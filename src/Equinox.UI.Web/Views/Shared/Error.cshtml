@model Equinox.UI.Web.Models.ErrorViewModel
@{
    if (Model == null || Model.ErrorCode == 500)
    {
        var requestId = System.Diagnostics.Activity.Current?.Id ?? Context.TraceIdentifier;

        ViewData["Title"] = "Algo deu errado";

        <div class="row justify-content-center my-5">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center p-5">
                        <h1 class="h2 mb-3">Algo deu errado</h1>
                        <p class="lead">Não conseguimos concluir a sua solicitação. Tente de novo em instantes.</p>
                        <p class="small text-muted text-break mb-4">Código da requisição: @requestId</p>
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar para a página inicial</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        ViewData["Title"] = "Oops! An error has occurred!";

        <h1>@Html.Raw(Model.Title)</h1>
        <h2 class="text-danger">@Html.Raw(Model.Message)</h2>
    }
}
